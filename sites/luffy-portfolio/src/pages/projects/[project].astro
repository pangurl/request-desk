---
import Layout from '../../layouts/Portfolio.astro';
import {projects} from '../../portfolio';
export function getStaticPaths() {return projects.map(project=>({params:{project:project.id},props:{project}}));}
const {project}=Astro.props;
---
<Layout title={project.name+' · Luffy Lu'}><a href="/">← 返回作品集</a><div class="overline">{project.number} / {project.name}</div><h1>{project.title}</h1><p>{project.description}</p>
<div class="links"><a class="cta" href={project.demo}>打开演示 ↗</a><a href={project.source}>{project.sourceLabel}</a></div>
<section class="grid"><article class="card"><h2>体验流程</h2><ol>{project.steps.map(step=><li>{step}</li>)}</ol></article><article class="card"><h2>实现方式</h2><p>{project.details}</p></article></section></Layout>
